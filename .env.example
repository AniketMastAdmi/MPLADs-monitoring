# Environment Configuration for MPLADS INSIGHT

# Application Settings
APP_NAME="MPLADS INSIGHT"
APP_ENV="development"
SECRET_KEY="supersecretkey-for-session-and-audit-signing"

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL="sqlite:///./mplads_insight.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mplads_db"

# API Port & Host
API_HOST="0.0.0.0"
API_PORT=8000

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"
